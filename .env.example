AETHER_CAMERA_INDEX=0
AETHER_FRAME_WIDTH=640
AETHER_FRAME_HEIGHT=480
AETHER_SIMILARITY_THRESHOLD=0.363
AETHER_WHISPER_MODEL=base
AETHER_WHISPER_DEVICE=auto
AETHER_WAKE_WORDS=aether          # e.g. computer, or several: aether,computer
AETHER_REQUIRE_LIVENESS=false     # true: enroll/forget need a recent "verify me" (head-turn check)
AETHER_VERIFIED_SECONDS=60
AETHER_FOLLOW_UP_SECONDS=10       # safe commands need no wake word this long after Aether speaks
AETHER_WHISPER_LANGUAGE=en        # or: auto
AETHER_WHISPER_THREADS=0          # 0 = half of the CPU threads
AETHER_DETECT_MAX_FPS=10
AETHER_DB_PATH=storage/aether.db
AETHER_LOG_LEVEL=INFO

# Local chat model for open questions (install Ollama, then: ollama pull llama3.2:3b)
AETHER_LLM_ENABLED=false
AETHER_LLM_MODEL=llama3.2:3b
